#!/usr/bin/env bash
# Nodestro Local Docker launcher (Linux and macOS; Windows: nodestro.ps1).
#
#   ./nodestro start | stop | restart | status | open | link | logout | logs | backup [FILE] | restore FILE
#              update | rollback | build | rotate-key | vault-key | rotate-vault-key
#              accept-new-vault-key --yes | uninstall [--delete-data] | help
#
# Needs only Docker (Docker Engine with the compose plugin, or Docker Desktop) and, for `build`, git.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
state_dir="${NODESTRO_STATE_DIR:-$here/.nodestro}"
state="$state_dir/state.env"
export NODESTRO_PROJECT="${NODESTRO_PROJECT:-nodestro-local}"
export NODESTRO_PORT="${NODESTRO_PORT:-8765}"

say() { printf '%s\n' "$*"; }
usage() {
  cat <<'USAGE'
Nodestro Local Docker launcher (Linux and macOS; Windows: nodestro.ps1). Needs Docker; build also needs git.

Usage: ./nodestro COMMAND

  start                       Start Nodestro (builds the image on first use) and open the studio
  stop                        Stop it; the data is kept
  restart                     Restart it and open the studio
  status                      Show the containers and whether Nodestro runs
  open                        Open the studio in the browser
  link                        Print the sign-in link (it contains the access key: keep it private)
  logout                      End every browser session
  logs [LINES]                Show the last log lines (default 200)
  backup [FILE]               Write a backup (default: backups/nodestro-backup-<time>.zip)
  restore FILE                Restore a backup
  update                      Back up, then switch to a new image; rolls back by itself if it does not start
  rollback                    Return to the image and the data from before the last update
  build                       Build the image from the pinned sources (needs git)
  rotate-key                  Replace the access key and open the studio with the new one
  vault-key                   Show where the key file for your secrets is (created if missing); keep a copy of it
                              somewhere safe, apart from the backups
  rotate-vault-key            Seal every stored secret with a new key file (also the copy kept for a rollback)
  accept-new-vault-key --yes  After losing the key file: remove the secrets it sealed (enter them again) and use a new key
  uninstall [--delete-data]   Remove Nodestro; the data volume is kept unless --delete-data
  help                        This text

Settings (environment variables):
  NODESTRO_PORT               Port on 127.0.0.1 (default 8765)
  NODESTRO_NO_BROWSER=1       Print the link instead of opening a browser
  NODESTRO_EXTRA_CA_FILE      Certificate bundle of a TLS-inspecting proxy
  NODESTRO_HTTPS_PROXY        Proxy for outgoing requests (model providers, packages, model downloads), as the
                              containers reach it (not 127.0.0.1); NODESTRO_NO_PROXY: more hosts to reach directly
  NODESTRO_UPDATE_IMAGE       Image for update (default: build from the pinned sources)
  NODESTRO_PROJECT            Compose project name (default nodestro-local)
  NODESTRO_STATE_DIR          Where the launcher keeps its state (default .nodestro next to it)
  NODESTRO_LOCAL_MODELS       on (default): local model server; offline: without internet (offline imports only);
                              off: none. Remembered until you set it again
  NODESTRO_IMPORT_DIR         Folder for offline model imports, /import in the studio (default: import next to this)
  NODESTRO_VAULT_KEY_FILE     The key file for provider keys, MCP tokens and connection secrets (default: Linux
                              ~/.config/nodestro-local/<project>/vault.key, macOS ~/Library/Application Support/
                              nodestro-local/<project>/vault.key); never inside this folder
USAGE
}
fail() { printf 'Nodestro: %s\n' "$*" >&2; exit 1; }

load_state() {
  local chosen_models="${NODESTRO_LOCAL_MODELS:-}"
  if [ -f "$state" ]; then
    # shellcheck disable=SC1090
    . "$state"
  fi
  export NODESTRO_IMAGE="${NODESTRO_IMAGE:-nodestro-local:dev}"
  # A value set now wins over the remembered one, and is remembered from now on.
  NODESTRO_LOCAL_MODELS="${chosen_models:-${NODESTRO_LOCAL_MODELS:-on}}"
  case "$NODESTRO_LOCAL_MODELS" in
    on|off|offline) ;;
    *) fail "NODESTRO_LOCAL_MODELS must be on, off or offline (not $NODESTRO_LOCAL_MODELS)." ;;
  esac
  if [ -n "$chosen_models" ]; then save_state; fi
  # The folder for offline model imports; created here so that Docker does not create it as root.
  if [ -z "${NODESTRO_IMPORT_DIR:-}" ]; then mkdir -p "$here/import" 2>/dev/null || true; fi
}

save_state() {
  mkdir -p "$state_dir"
  {
    printf 'NODESTRO_IMAGE=%q\n' "$NODESTRO_IMAGE"
    printf 'NODESTRO_PREVIOUS_IMAGE=%q\n' "${NODESTRO_PREVIOUS_IMAGE:-}"
    printf 'NODESTRO_LOCAL_MODELS=%q\n' "${NODESTRO_LOCAL_MODELS:-on}"
  } > "$state"
}

# ---- the key file (LD-020, docs/SECURITY.md "The key file") ----------------------------------------------------------
# Provider keys, MCP tokens and connection secrets are sealed with a key kept in a file on the host: outside this folder,
# the data volume, the images and the backups; 0600 in a 0700 folder of the current user. Created once with the
# system's cryptographic random generator, and never replaced by the launcher: without it the studio does not start.

vault_key_file() {
  if [ -n "${NODESTRO_VAULT_KEY_FILE:-}" ]; then
    case "$NODESTRO_VAULT_KEY_FILE" in
      /*) printf '%s' "$NODESTRO_VAULT_KEY_FILE" ;;
      *) printf '%s/%s' "$PWD" "$NODESTRO_VAULT_KEY_FILE" ;;
    esac
    return
  fi
  case "$(uname -s)" in
    Darwin) printf '%s' "$HOME/Library/Application Support/nodestro-local/$NODESTRO_PROJECT/vault.key" ;;
    *) printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/nodestro-local/$NODESTRO_PROJECT/vault.key" ;;
  esac
}

file_mode() { stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1"; }
file_owner() { stat -c '%u' "$1" 2>/dev/null || stat -f '%u' "$1"; }

# FILE: refuse a key file (or its folder) that is a link, belongs to someone else or is open to others.
check_vault_key() {
  local file="$1" dir mode
  dir="$(dirname "$file")"
  if [ -L "$file" ] || [ ! -f "$file" ]; then fail "The key file $file is not a regular file."; fi
  [ ! -L "$dir" ] || fail "The folder of the key file ($dir) is a symbolic link."
  if [ "$(file_owner "$file")" != "$(id -u)" ] || [ "$(file_owner "$dir")" != "$(id -u)" ]; then
    fail "The key file $file or its folder belongs to another user."
  fi
  mode="$(file_mode "$file")"
  [ $((8#$mode & 8#077)) -eq 0 ] || fail "The key file $file can be read by others (mode $mode); fix it: chmod 600 \"$file\""
  mode="$(file_mode "$dir")"
  [ $((8#$mode & 8#077)) -eq 0 ] || fail "The folder $dir is open to others (mode $mode); fix it: chmod 700 \"$dir\""
}

# FILE: create a new key file there unless one exists (atomically; an existing file is never replaced).
new_vault_key() {
  local file="$1" dir tmp
  dir="$(dirname "$file")"
  case "$file/" in "$here"/*) fail "The key file must not be inside $here (it would end up in copies of this folder)." ;; esac
  if [ -e "$file" ] || [ -L "$file" ]; then return 0; fi
  (umask 077 && mkdir -p "$dir") || fail "Creating the folder $dir for the key file failed."
  tmp="$(umask 077 && mktemp "$dir/.vault-key-XXXXXX")" || fail "Creating the key file $file failed."
  # 32 bytes from the kernel's cryptographic random generator, base64.
  if ! head -c 32 /dev/urandom | base64 | tr -d '\n' > "$tmp" || [ "$(wc -c < "$tmp" | tr -d ' ')" -ne 44 ]; then
    rm -f "$tmp"; fail "Creating the key file $file failed."
  fi
  printf '\n' >> "$tmp"
  # ln refuses to replace an existing file: two launchers at once never write two keys.
  ln "$tmp" "$file" 2>/dev/null || { rm -f "$tmp"; return 0; }
  rm -f "$tmp"
  return 1
}

ensure_vault_key() {
  local file
  file="$(vault_key_file)"
  if ! new_vault_key "$file"; then
    say "Created the key file for your secrets: $file" >&2
    say "  Keep a copy of it somewhere safe (not with the backups): without it, stored provider keys, MCP tokens and" >&2
    say "  connection secrets cannot be read again." >&2
    if command -v docker >/dev/null 2>&1 && docker volume inspect "$(volume data)" >/dev/null 2>&1; then
      say "  The data volume $(volume data) exists already. If its secrets were sealed with an earlier key file, Nodestro" >&2
      say "  will refuse to start: put the earlier file back at this path, or give them up: ./nodestro accept-new-vault-key --yes" >&2
    fi
  fi
  check_vault_key "$file"
  export NODESTRO_VAULT_KEY_HOST_FILE="$file"
}

# Whether IMAGE reads the key file (images before LD-020, after a rollback, do not).
image_has_vault_key() {
  [ "$(docker image inspect --format '{{ index .Config.Labels "dev.nodestro.vault-key-file" }}' "$1" 2>/dev/null)" = 1 ]
}

compose() {
  local files=(-f "$here/compose.yaml")
  if image_has_vault_key "$NODESTRO_IMAGE"; then
    ensure_vault_key
    files+=(-f "$here/compose.vault-key.yaml")
  fi
  if [ -n "${NODESTRO_EXTRA_CA_FILE:-}" ]; then files+=(-f "$here/compose.extra-ca.yaml"); fi
  # Before the offline file, which closes Ollama's downloads again.
  if [ -n "${NODESTRO_HTTPS_PROXY:-}" ]; then files+=(-f "$here/compose.proxy.yaml"); fi
  case "${NODESTRO_LOCAL_MODELS:-on}" in
    off) files+=(-f "$here/compose.local-models-off.yaml") ;;
    offline) files+=(-f "$here/compose.local-models-offline.yaml") ;;
  esac
  # The user's own additions (README: model providers), as plain `docker compose` would read them.
  if [ -f "$here/compose.override.yaml" ]; then files+=(-f "$here/compose.override.yaml"); fi
  docker compose --project-directory "$here" "${files[@]}" "$@"
}

require_docker() {
  command -v docker >/dev/null 2>&1 || fail "Docker is not installed. Install Docker Desktop (Windows, macOS) or Docker Engine (Linux): https://docs.docker.com/get-docker/"
  docker info >/dev/null 2>&1 || fail "Docker is installed but not running (or you may not use it). Start Docker Desktop, or on Linux: sudo systemctl start docker (and add yourself to the docker group, or use rootless Docker)."
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is missing (docker compose). Update Docker Desktop, or install the docker-compose-plugin package."
  rootless_socket
}

# Rootless Docker: the gateway needs the user's daemon socket, not /var/run/docker.sock. It is taken from DOCKER_HOST
# or the current docker context, but only when it is a rootless socket (/run/user/<uid>/docker.sock). Docker
# Desktop's contexts name a socket on the host that does not exist inside its VM, so they keep the default.
rootless_socket() {
  [ -z "${NODESTRO_DOCKER_SOCKET:-}" ] || return 0
  local host
  host="$(docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null || true)"
  case "$host" in
    unix:///run/user/[0-9]*/docker.sock)
      export NODESTRO_DOCKER_SOCKET="${host#unix://}"
      say "Rootless Docker: the sandbox gateway uses $NODESTRO_DOCKER_SOCKET." >&2
      ;;
  esac
}

require_image() {
  if ! docker image inspect "$NODESTRO_IMAGE" >/dev/null 2>&1; then
    say "The Nodestro image $NODESTRO_IMAGE is not here yet. Building it from source (takes several minutes, once)..."
    build
  fi
}

build() {
  command -v git >/dev/null 2>&1 || fail "git is needed to build the image (it fetches the pinned sources)."
  local tag
  tag="$("$here/scripts/build-image.sh" | tail -n 1)"
  NODESTRO_IMAGE="$tag"
  save_state
  say "Built $tag"
}

link() {
  compose exec -T --user 10001:10001 nodestro nodestro-local link --port "$NODESTRO_PORT" | tr -d '\r'
}

open_browser() {
  local url page opener=""
  url="$(link)"
  # The browser gets a private file that forwards to the link, so the access key never appears in a process list.
  page="$(umask 077 && mktemp "${TMPDIR:-/tmp}/nodestro-open-XXXXXX")"
  mv "$page" "$page.html" && page="$page.html"
  printf '<!doctype html><meta charset="utf-8"><meta http-equiv="refresh" content="0;url=%s"><title>Nodestro</title>' "$url" > "$page"
  if command -v xdg-open >/dev/null 2>&1; then opener=xdg-open
  elif command -v open >/dev/null 2>&1; then opener=open
  elif command -v wslview >/dev/null 2>&1; then opener=wslview
  fi
  say "Nodestro is running. Open it with this link (it contains your access key, keep it private):"
  say "  $url"
  if [ -n "$opener" ] && [ -z "${NODESTRO_NO_BROWSER:-}" ]; then
    "$opener" "$page" >/dev/null 2>&1 || true
    ( sleep 60; rm -f "$page" ) >/dev/null 2>&1 &
  else
    rm -f "$page"
  fi
}

start() {
  require_docker
  load_state
  require_image
  local models_image
  if [ "$NODESTRO_LOCAL_MODELS" != off ]; then
    models_image="$(compose config --images 2>/dev/null | grep -m 1 '/ollama[:@]' || true)"
    if [ -n "$models_image" ] && ! docker image inspect "$models_image" >/dev/null 2>&1; then
      say "Downloading the local model server (Ollama, about 3.4 GB on amd64, once; NODESTRO_LOCAL_MODELS=off skips it)..."
    fi
  fi
  say "Starting Nodestro (image $NODESTRO_IMAGE, port $NODESTRO_PORT on 127.0.0.1)..."
  if ! compose up -d --wait --wait-timeout 300; then
    compose ps || true
    compose logs --tail 40 || true
    fail "Nodestro did not start. The lines above say why (a port in use: set NODESTRO_PORT=another port)."
  fi
  open_browser
}

volume() { printf '%s_%s' "$NODESTRO_PROJECT" "$1"; }

copy_volume() { # FROM TO: replace the contents of volume TO with those of FROM (both must exist)
  docker run --rm --network none --user 0:0 --entrypoint sh \
    -v "$1:/from:ro" -v "$2:/to" "$NODESTRO_IMAGE" \
    -c 'find /to -mindepth 1 -maxdepth 1 -exec rm -rf {} + && cp -a /from/. /to/'
}

update() {
  require_docker
  load_state
  local previous="$NODESTRO_IMAGE" snapshot
  snapshot="$(volume data-before-update)"
  if compose ps --status running --services 2>/dev/null | grep -qx nodestro; then
    mkdir -p "$here/backups"
    local file
    file="$here/backups/before-update-$(date +%Y%m%d-%H%M%S).zip"
    compose exec -T --user 10001:10001 nodestro nodestro-local backup > "$file" && say "Backup written to $file"
  fi
  if [ -n "${NODESTRO_UPDATE_IMAGE:-}" ]; then  # an image built or loaded elsewhere
    docker image inspect "$NODESTRO_UPDATE_IMAGE" >/dev/null 2>&1 || fail "The image $NODESTRO_UPDATE_IMAGE is missing."
    NODESTRO_IMAGE="$NODESTRO_UPDATE_IMAGE"
  else
    build
  fi
  local next="$NODESTRO_IMAGE"
  NODESTRO_IMAGE="$previous"
  say "Stopping Nodestro and keeping a copy of its data for a rollback..."
  compose stop nodestro >/dev/null
  docker volume create "$snapshot" >/dev/null
  if docker volume inspect "$(volume data)" >/dev/null 2>&1; then copy_volume "$(volume data)" "$snapshot"; fi
  NODESTRO_PREVIOUS_IMAGE="$previous"
  NODESTRO_IMAGE="$next"
  save_state
  if ! compose up -d --wait --wait-timeout 300; then
    say "The new version did not start; going back to $previous."
    rollback
    fail "Update failed and was rolled back."
  fi
  say "Updated to $next (rollback: ./nodestro rollback)."
  open_browser
}

# VOLUME OLD NEW: seal the secrets of the data in VOLUME with the key file NEW instead of OLD (studio stopped).
rekey_volume() {
  boot_run "$1" rekey --mount "type=bind,source=$2,target=/run/secrets/nodestro-vault-key,readonly" \
    --mount "type=bind,source=$3,target=/run/secrets/nodestro-vault-key-new,readonly"
}

# VOLUME ACTION [docker run options]: `nodestro-local boot ACTION` on the data in VOLUME, as the studio's container
# runs it (root with three capabilities until it drops to the studio's user), without network.
boot_run() {
  local data="$1" action="$2"
  shift 2
  docker run --rm --network none --read-only --tmpfs /tmp --user 0:0 --cap-drop ALL \
    --cap-add DAC_READ_SEARCH --cap-add SETUID --cap-add SETGID --security-opt no-new-privileges:true \
    --entrypoint nodestro-local -v "$data:/var/lib/nodestro" "$@" "$NODESTRO_IMAGE" boot "$action"
}

rotate_vault_key() {
  require_docker
  load_state
  image_has_vault_key "$NODESTRO_IMAGE" || fail "The image $NODESTRO_IMAGE has no key file support; update first (./nodestro update)."
  ensure_vault_key
  local file new data snapshot
  file="$NODESTRO_VAULT_KEY_HOST_FILE"
  new="$file.new"
  data="$(volume data)"
  snapshot="$(volume data-before-update)"
  # A new key from an interrupted rotation is used again: the data may be sealed with it already.
  if new_vault_key "$new"; then say "Continuing the rotation with $new."; fi
  check_vault_key "$new"
  say "Stopping Nodestro to seal its secrets with the new key..."
  compose stop nodestro >/dev/null
  if docker volume inspect "$data" >/dev/null 2>&1 && ! rekey_volume "$data" "$file" "$new"; then
    compose up -d --wait --wait-timeout 300 >/dev/null || true
    fail "The rotation stopped; nothing was changed and the key file stays $file."
  fi
  if docker volume inspect "$snapshot" >/dev/null 2>&1 && ! rekey_volume "$snapshot" "$file" "$new"; then
    rekey_volume "$data" "$new" "$file" || fail "The rotation failed half-way: keep both $file and $new and run ./nodestro rotate-vault-key again."
    compose up -d --wait --wait-timeout 300 >/dev/null || true
    fail "The copy kept for a rollback could not be sealed with the new key; nothing was changed."
  fi
  mv -f "$new" "$file"
  compose up -d --wait --wait-timeout 300 || fail "Nodestro did not start with the new key; see: ./nodestro logs"
  say "Every stored secret is sealed with the new key in $file; the old key is gone."
  say "Backups written before keep their MCP tokens and connection secrets sealed with the old key: after a restore"
  say "they count as missing and have to be entered again. Replace your safe copy of the key file with the new one."
}

accept_new_vault_key() {
  [ "${1:-}" = "--yes" ] || fail "This removes every stored provider key, MCP token and connection secret that the current key file cannot open (they have to be entered again). Only for a lost key file; if you still have it, put it back at $(vault_key_file) instead. Confirm with: ./nodestro accept-new-vault-key --yes"
  require_docker
  load_state
  image_has_vault_key "$NODESTRO_IMAGE" || fail "The image $NODESTRO_IMAGE has no key file support; update first (./nodestro update)."
  ensure_vault_key
  local volume_name
  compose stop nodestro >/dev/null
  for volume_name in "$(volume data)" "$(volume data-before-update)"; do
    if docker volume inspect "$volume_name" >/dev/null 2>&1; then
      boot_run "$volume_name" discard-unreadable \
        --mount "type=bind,source=$NODESTRO_VAULT_KEY_HOST_FILE,target=/run/secrets/nodestro-vault-key,readonly" \
        || fail "Removing the unreadable secrets in $volume_name failed."
    fi
  done
  compose up -d --wait --wait-timeout 300 || fail "Nodestro did not start; see: ./nodestro logs"
  say "Nodestro uses the key file $NODESTRO_VAULT_KEY_HOST_FILE now; enter the removed keys and tokens again."
}

rollback() {
  require_docker
  load_state
  [ -n "${NODESTRO_PREVIOUS_IMAGE:-}" ] || fail "There is no earlier version to go back to."
  docker volume inspect "$(volume data-before-update)" >/dev/null 2>&1 || fail "The copy of the data from before the update is missing."
  compose stop nodestro >/dev/null 2>&1 || true
  copy_volume "$(volume data-before-update)" "$(volume data)"
  NODESTRO_IMAGE="$NODESTRO_PREVIOUS_IMAGE"
  NODESTRO_PREVIOUS_IMAGE=""
  save_state
  compose up -d --wait --wait-timeout 300 || fail "The earlier version did not start either; see: ./nodestro logs"
  say "Back on $NODESTRO_IMAGE with the data from before the update."
}

command="${1:-help}"
shift || true
case "$command" in
  start) start ;;
  stop) require_docker; load_state; compose stop; say "Nodestro stopped. Your data is kept (start again: ./nodestro start)." ;;
  # stop + up, not `compose restart`: it restarts the services in parallel, and a container cannot join the namespace
  # of `network` while that one restarts.
  restart) require_docker; load_state; compose stop; compose up -d --wait --wait-timeout 300; open_browser ;;
  status)
    require_docker; load_state
    compose ps
    say "Key file for your secrets: $(vault_key_file)"
    compose exec -T --user 10001:10001 nodestro nodestro-local status 2>/dev/null || say "Nodestro is not running."
    ;;
  open) require_docker; load_state; open_browser ;;
  link) require_docker; load_state; link ;;
  logout) require_docker; load_state; compose exec -T --user 10001:10001 nodestro nodestro-local logout ;;
  logs) require_docker; load_state; compose logs --tail "${1:-200}" ;;
  backup)
    require_docker; load_state
    file="${1:-$here/backups/nodestro-backup-$(date +%Y%m%d-%H%M%S).zip}"
    mkdir -p "$(dirname "$file")"
    compose exec -T --user 10001:10001 nodestro nodestro-local backup > "$file" || { rm -f "$file"; fail "The backup failed (is Nodestro running?)"; }
    say "Backup written to $file"
    ;;
  restore)
    require_docker; load_state
    [ -f "${1:-}" ] || fail "Name the backup file: ./nodestro restore FILE"
    compose exec -T --user 10001:10001 nodestro nodestro-local restore < "$1"
    say "Restored $1 (the state before it was saved as a safety backup inside Nodestro)."
    ;;
  update) update ;;
  rollback) rollback ;;
  build) require_docker; load_state; build ;;
  vault-key)
    ensure_vault_key
    say "$NODESTRO_VAULT_KEY_HOST_FILE"
    ;;
  rotate-vault-key) rotate_vault_key ;;
  accept-new-vault-key) accept_new_vault_key "${1:-}" ;;
  rotate-key)
    require_docker; load_state
    compose exec -T --user 10001:10001 nodestro nodestro-local rotate-key
    compose restart nodestro; compose up -d --wait --wait-timeout 300; open_browser
    ;;
  uninstall)
    require_docker; load_state
    if [ "${1:-}" = "--delete-data" ]; then
      compose down -v; docker volume rm "$(volume data-before-update)" >/dev/null 2>&1 || true
      # The key file is of no use without the data; the launcher created it, so it removes it.
      key_file="$(vault_key_file)"
      rm -f "$key_file" "$key_file.new"
      rmdir "$(dirname "$key_file")" 2>/dev/null || true
      say "Nodestro and all its data were removed, and the key file $key_file."
    else
      compose down; say "Nodestro was removed; its data volume $(volume data) is kept."
    fi
    ;;
  help|-h|--help)
    usage
    ;;
  *) fail "Unknown command $command (see ./nodestro help)" ;;
esac
